# ---------------------------------------------------------------
# Database — SQLite is used by default for a zero-config setup.
# To use PostgreSQL: change provider in prisma/schema.prisma to
# "postgresql" and set a postgres connection string here.
# ---------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Base public URL of the application (used in emails and callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Secret used to sign session cookies / verification tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-secret"

# ---------------------------------------------------------------
# Payment gateways — leave blank to keep a gateway disabled.
# Credentials are never exposed to the browser. Only the boolean
# "enabled" state is read by the UI.
# ---------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------
# FamPay UPI QR — no API credentials are required. Set your UPI ID
# (VPA) to activate the QR option. You can also configure this from
# Admin → Settings → FamPay UPI QR without editing this file.
# ---------------------------------------------------------------
# Server-side only. Never exposed to the browser. Required only if your
# FamPay merchant account provides direct API/webhook verification.
FAMPAY_API_KEY=""
# FamGateway (https://famgateway.in) — the API key above creates real UPI
# sessions at POST /api/create-order and verifies via webhook/status API.
FAMPAY_UPI_ID=""
# Optional. Leave blank to use the payee name configured in Admin → Settings.
FAMPAY_MERCHANT_NAME=""

# ---------------------------------------------------------------
# Email (SMTP). You can also set these in Admin → Settings → Email delivery.
# Zoho: smtp.zoho.in, port 465 (SSL) or 587 (TLS), authentication required.
# Use a Zoho app password, not your normal account password.
# ---------------------------------------------------------------
SMTP_HOST="smtp.zoho.in"
SMTP_PORT="465"
SMTP_USER="support@wardenhost.net"
SMTP_PASSWORD=""
SMTP_FROM="WardenHost <support@wardenhost.net>"

# Admin account created by the seed script (change before first run)
SEED_ADMIN_EMAIL="admin@wardenhost.example"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_DEMO_EMAIL="demo@example.com"
SEED_DEMO_PASSWORD="Demo@12345"

# ---------------------------------------------------------------
# Installation lock. The site will not render unless LICENSE_KEY is
# set and the request host is listed in ALLOWED_DOMAINS. Keep .env
# private — never commit it or publish it with the source files.
# ---------------------------------------------------------------
LICENSE_KEY=""
ALLOWED_DOMAINS="localhost,127.0.0.1,wardenhost.net,www.wardenhost.net"
# Password for the separate /license panel. Change this before deployment.
LICENSE_PANEL_PASSWORD="FroggyLive"
# API connection to the separate license panel on port 3006
LICENSE_PANEL_URL="http://localhost:3006"
LICENSE_API_TOKEN="change-this-shared-secret"
# Optional secret for POST /api/cron/maintenance
CRON_SECRET="change-me"

# ---------------------------------------------------------------
# Provisioning panel (optional). When both are set, verified payments
# POST service details to this URL to create VPS/Minecraft instances.
# ---------------------------------------------------------------
PANEL_API_URL=""
PANEL_API_KEY=""
