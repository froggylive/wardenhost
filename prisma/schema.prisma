// WardenHost — relational schema.
// Default provider is SQLite for a zero-config working install.
// For production PostgreSQL: change provider to "postgresql" and set DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  passwordHash        String
  role                String              @default("CUSTOMER") // CUSTOMER | ADMIN
  emailVerified       Boolean             @default(false)
  verificationToken   String?             @unique
  resetToken          String?             @unique
  resetTokenExpires   DateTime?
  phone               String?
  company             String?
  address             String?
  city                String?
  country             String?
  postalCode          String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  sessions            Session[]
  orders              Order[]
  services            Service[]
  invoices            Invoice[]
  transactions        Transaction[]
  couponRedemptions   CouponRedemption[]
  tickets             SupportTicket[]
  ticketMessages      TicketMessage[]
  activityLogs        AdminActivityLog[]

  @@index([role])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  icon        String   @default("Server")
  image       String?
  panelCode   String?
  displayOrder Int     @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plans        Plan[]
  cpuPrices    CpuCategoryPrice[]
  couponCategories CouponCategory[]

  @@index([active, displayOrder])
}

model Plan {
  id             String         @id @default(cuid())
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  slug           String         @unique
  ram            String
  cpu            String
  disk           String
  storageType    String         @default("NVMe SSD")
  bandwidth      String
  networkSpeed   String
  ipv4Count      Int            @default(1)
  priceCents     Int
  currency       String         @default("INR")
  billingPeriod  String         @default("monthly")
  shortDescription String?
  fullDescription  String?
  orderUrl       String?
  image          String?
  active         Boolean        @default(true)
  inStock        Boolean        @default(true)
  featured       Boolean        @default(false)
  displayOrder   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  features       PlanFeature[]
  orders         Order[]
  services       Service[]
  couponPlans    CouponPlan[]

  @@index([categoryId, active])
  @@index([featured])
}

model PlanFeature {
  id           String @id @default(cuid())
  planId       String
  plan         Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  text         String
  displayOrder Int    @default(0)

  @@index([planId])
}

model CpuOption {
  id           String   @id @default(cuid())
  name         String   @unique
  priceCents   Int      @default(0)
  active       Boolean  @default(true)
  inStock      Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  categoryPrices CpuCategoryPrice[]

  @@index([active, displayOrder])
}

model PanelConfig {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  apiUrl      String
  apiKey      String
  createPath  String   @default("/api/create")
  deletePath  String   @default("/api/delete")
  testPath    String   @default("/api/health")
  authHeader  String   @default("Authorization")
  authScheme  String   @default("Bearer")
  adminUser   String?
  adminPassword String?
  active      Boolean  @default(true)
  description String?
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, displayOrder])
}

model CpuCategoryPrice {
  id         String @id @default(cuid())
  cpuOptionId String
  categoryId  String
  priceCents  Int    @default(0)
  cpuOption   CpuOption @relation(fields: [cpuOptionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([cpuOptionId, categoryId])
}

model BillingPeriod {
  id          String  @id @default(cuid())
  code        String  @unique // monthly | quarterly | semiannual | annual
  label       String
  months      Int
  multiplier  Float   @default(1) // price = base monthly price * months * multiplier
  active      Boolean @default(true)
  displayOrder Int    @default(0)
  orders      Order[]

  @@index([active, displayOrder])
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String?
  plan            Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName        String          // snapshot
  cpuOptionId     String?
  cpuName         String?         // snapshot
  billingPeriodId String?
  billingPeriod   BillingPeriod?  @relation(fields: [billingPeriodId], references: [id], onDelete: SetNull)
  billingLabel    String
  amountCents     Int
  discountCents   Int             @default(0)
  taxCents        Int             @default(0)
  currency        String          @default("INR")
  couponCode      String?
  status          String          @default("PENDING") // PENDING|AWAITING_PAYMENT|PROCESSING|ACTIVE|CANCELLED|FAILED
  paymentStatus   String          @default("UNPAID") // UNPAID|PAID|REFUNDED|FAILED
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  services        Service[]
  invoices        Invoice[]
  transactions    Transaction[]
  redemptions     CouponRedemption[]

  @@index([userId, createdAt])
  @@index([status])
}

model Service {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String?
  plan        Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  name        String
  planName    String
  ram         String
  cpu         String
  disk        String
  status      String    @default("PENDING") // PENDING|ACTIVE|SUSPENDED|CANCELLED|EXPIRED|DELETED
  startDate   DateTime  @default(now())
  expiresAt   DateTime?
  renewalDate DateTime?
  panelCode   String?
  externalId  String?
  expiryNotifiedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subtotalCents     Int
  discountCents     Int           @default(0)
  taxCents          Int           @default(0)
  totalCents        Int
  currency          String        @default("INR")
  status            String        @default("UNPAID") // DRAFT|UNPAID|PAID|CANCELLED|REFUNDED
  planName          String
  billingLabel      String
  dueDate           DateTime?
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             InvoiceItem[]
  transactions      Transaction[]

  @@index([userId, createdAt])
  @@index([status])
}

model InvoiceItem {
  id              String  @id @default(cuid())
  invoiceId       String
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description     String
  quantity        Int     @default(1)
  unitPriceCents  Int
  amountCents     Int

  @@index([invoiceId])
}

model Transaction {
  id             String    @id @default(cuid())
  transactionId  String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  gateway        String    @default("manual") // manual | razorpay | stripe
  paymentMethod  String?
  amountCents    Int
  currency       String    @default("INR")
  status         String    @default("PENDING") // PENDING|SUCCESS|FAILED|REFUNDED
  gatewayRef     String?
  note           String?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status])
  @@index([invoiceId])
}

model PaymentMethod {
  id          String  @id @default(cuid())
  code        String  @unique // manual | fampay | razorpay | stripe
  name        String
  description String?
  enabled     Boolean @default(false)
  displayOrder Int    @default(0)

  @@index([enabled, displayOrder])
}

/// Server-side gateway credentials. Never included in public website settings.
model GatewayCredential {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model License {
  id             String    @id @default(cuid())
  key            String    @unique
  label          String    @default("Client license")
  allowedDomains String    @default("localhost,127.0.0.1")
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  activatedAt    DateTime?
  lastDomain     String?

  @@index([active])
}

model Coupon {
  id             String              @id @default(cuid())
  code           String              @unique
  type           String              @default("PERCENT") // PERCENT | FIXED
  value          Int                 // percent (0-100) or amount in minor units
  maxUses        Int?
  uses           Int                 @default(0)
  minAmountCents Int                 @default(0)
  expiresAt      DateTime?
  active         Boolean             @default(true)
  appliesTo      String              @default("ALL") // ALL | CATEGORIES | PLANS
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  redemptions    CouponRedemption[]
  categories     CouponCategory[]
  plans          CouponPlan[]

  @@index([active])
}

model CouponCategory {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
}

model CouponPlan {
  id      String @id @default(cuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([couponId, planId])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([couponId])
}

model SupportTicket {
  id          String          @id @default(cuid())
  ticketNumber String         @unique
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  String          @default("General")
  subject     String
  status      String          @default("OPEN") // OPEN|IN_PROGRESS|AWAITING_CUSTOMER|CLOSED
  priority    String          @default("NORMAL")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  messages    TicketMessage[]

  @@index([userId, createdAt])
  @@index([status])
}

model TicketMessage {
  id            String        @id @default(cuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId      String
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName    String
  isAdmin       Boolean       @default(false)
  isInternal    Boolean       @default(false)
  message       String
  attachmentPath String?
  attachmentName String?
  createdAt     DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active])
}

model WebsiteSetting {
  key   String @id
  value String // JSON-encoded value
}

model AdminActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}
